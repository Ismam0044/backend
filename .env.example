# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev (docker-compose Postgres service):
DATABASE_URL=postgres://erp:erp@db:5432/erp

# Production (Neon) example - set this in Render's environment settings instead of here:
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/erp?sslmode=require

# Only needed when DEBUG=False and serving over a custom domain:
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Optional error monitoring - set this in Render's environment settings, not here.
# Left blank, Sentry stays fully inactive (including locally).
# SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx

# Required for the AI features (chat, smart reorder, receipt scanning).
# Free key from https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=
